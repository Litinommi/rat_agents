# --- OpenAI-compatible inference ----------------------------------------
# Local Ollama example. The API key is a required SDK placeholder and is not
# sent to a separate service when this local endpoint is used.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://192.168.200.182:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.8:latest
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
LLM_STREAM=false
LLM_VISION=false
LLM_TIMEOUT_SECONDS=300

# --- YouTube app (driven via uiautomator2, no Appium server) ---------------
YOUTUBE_PACKAGE=com.google.android.youtube
YOUTUBE_APP_ACTIVITY=com.google.android.apps.youtube.app.WatchWhileActivity

# --- ADB -------------------------------------------------------------------
ADB_TIMEOUT_SECONDS=15

# --- Test defaults -------------------------------------------------------
DEFAULT_TEST_DURATION_SECONDS=60
DEFAULT_SEARCH_QUERY=lofi hip hop radio
PLAYBACK_POLL_INTERVAL_SECONDS=5

# --- Safety limits ---------------------------------------------------------
MAX_FIXES_PER_DEVICE=3
FIX_MAX_TOOL_CALLS=25
MAX_WAIT_SECONDS=180
MAX_LLM_TURNS=60

# --- Logging ---------------------------------------------------------------
LOGCAT_LINE_LIMIT=400
