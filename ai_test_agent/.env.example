# --- NVIDIA NIM ---------------------------------------------------------
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
NVIDIA_NIM_MODEL=your_supported_model_id
NVIDIA_NIM_MAX_TOKENS=32768
NVIDIA_NIM_TEMPERATURE=1.0
NVIDIA_NIM_TOP_P=0.95
NVIDIA_NIM_STREAM=false
NVIDIA_NIM_VISION=false
NVIDIA_NIM_TIMEOUT_SECONDS=120

# --- YouTube app (driven via uiautomator2, no Appium server) ---------------
YOUTUBE_PACKAGE=com.google.android.youtube
YOUTUBE_APP_ACTIVITY=com.google.android.apps.youtube.app.WatchWhileActivity

# --- ADB -------------------------------------------------------------------
ADB_TIMEOUT_SECONDS=15

# --- Test defaults -------------------------------------------------------
DEFAULT_TEST_DURATION_SECONDS=60
DEFAULT_SEARCH_QUERY=lofi hip hop radio
PLAYBACK_POLL_INTERVAL_SECONDS=5

# --- Safety limits ---------------------------------------------------------
MAX_FIXES_PER_DEVICE=3
FIX_MAX_TOOL_CALLS=25
MAX_WAIT_SECONDS=180
MAX_LLM_TURNS=60

# --- Logging ---------------------------------------------------------------
LOGCAT_LINE_LIMIT=400
