  "cards": [
    { "dot": "cyan", "title": "Two ways to start", "items": [
      "play_youtube.py: Python calls the steps in order with no AI and no tokens",
      "agent.py: Claude calls every step itself, one tool per turn",
      "play_youtube.py --ai-fallback sends one failed phone per YouTube version + language to Claude, then re-runs the rest for free with the new recipe"
    ] },
    { "dot": "emerald", "title": "Learning loop", "items": [
      "Stats + fullscreen try saved recipes first: exact phone, then same YouTube version + language, then others",
      "A recipe that works for a different profile is copied to this phone's profile",
      "Some phones must first switch on Settings → General → Enable stats for nerds (a recipe-only step)"
    ] },
    { "dot": "rose", "title": "Hard stops", "items": [
      "Pre-flight exits early if a phone is missing, the URL isn't YouTube, duration < 5 s, or there's no API key",
      "Monitoring refuses to start until Stats for nerds is visible",
      "retry_test is capped at 2; when the tool or turn budget runs out, agent.py writes a NEEDS_HUMAN report",
      "Taps that leave YouTube are undone with Back and never saved"
    ] }
